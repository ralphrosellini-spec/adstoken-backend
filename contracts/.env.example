# Your MetaMask / Web3 wallet private key (used ONLY for deploying on BSC Testnet)
# WARNING: Use a dedicated development/test wallet, NEVER a wallet with real mainnet funds.
PRIVATE_KEY=your_private_key_here

# Optional custom RPC (default is https://bsc-testnet.publicnode.com)
BSC_TESTNET_RPC=https://bsc-testnet.publicnode.com
